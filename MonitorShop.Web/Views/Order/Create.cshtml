@model MonitorShop.Entities.Order

@{
    ViewData["Title"] = "Create Order";
}

<div class="container mt-4">
    <h2>Create Order</h2>

    <form asp-controller="Order"
          asp-action="Create"
          method="post">

        <div asp-validation-summary="All"
             class="text-danger mb-3">
        </div>

        <div class="mb-3">
            <label asp-for="UserId" class="form-label">User</label>

            <select asp-for="UserId"
                    asp-items="ViewBag.Users"
                    class="form-select">

                <option value="">Select User</option>
            </select>

            <span asp-validation-for="UserId"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="OrderDate" class="form-label">Order Date</label>

            <input asp-for="OrderDate"
                   type="datetime-local"
                   class="form-control" />

            <span asp-validation-for="OrderDate"
                  class="text-danger">
            </span>
        </div>

        <div class="mb-3">
            <label asp-for="TotalPrice" class="form-label">Total Price</label>

            <input asp-for="TotalPrice"
                   type="number"
                   step="0.01"
                   min="0"
                   class="form-control" />

            <span asp-validation-for="TotalPrice"
                  class="text-danger">
            </span>
        </div>

        <button type="submit" class="btn btn-success">
            Save
        </button>

        <a asp-controller="Order"
           asp-action="Index"
           class="btn btn-secondary">
            Back
        </a>
    </form>
</div>