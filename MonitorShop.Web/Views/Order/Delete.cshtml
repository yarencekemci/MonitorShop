@model MonitorShop.Entities.Order

@{
    ViewData["Title"] = "Delete Order";
}

<div class="container mt-4">
    <h2>Delete Order</h2>

    <div class="alert alert-warning">
        Are you sure you want to delete this order?
    </div>

    <dl class="row">
        <dt class="col-sm-3">Order ID</dt>
        <dd class="col-sm-9">@Model.Id</dd>

        <dt class="col-sm-3">User ID</dt>
        <dd class="col-sm-9">@Model.UserId</dd>

        <dt class="col-sm-3">Order Date</dt>
        <dd class="col-sm-9">
            @Model.OrderDate.ToString("dd.MM.yyyy HH:mm")
        </dd>

        <dt class="col-sm-3">Total Price</dt>
        <dd class="col-sm-9">
            @Model.TotalPrice.ToString("C2")
        </dd>
    </dl>

    <form asp-controller="Order"
          asp-action="DeleteConfirmed"
          method="post">

        <input type="hidden"
               name="id"
               value="@Model.Id" />

        <button type="submit" class="btn btn-danger">
            Delete
        </button>

        <a asp-controller="Order"
           asp-action="Index"
           class="btn btn-secondary">
            Cancel
        </a>
    </form>
</div>