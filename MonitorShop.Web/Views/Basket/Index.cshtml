@{
    ViewData["Title"] = "Shopping Basket";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">

    <h2 class="mb-4">Shopping Basket</h2>

    <div id="emptyBasketMessage"
         class="alert alert-info"
         style="display: none;">
        Your basket is empty.
    </div>

    <div id="basketContent">

        <table class="table table-bordered align-middle">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Product</th>
                    <th>Price</th>
                    <th>Quantity</th>
                    <th>Total</th>
                    <th>Delete</th>
                </tr>
            </thead>

            <tbody id="basketBody">
            </tbody>
        </table>

        <div class="text-right">
            <h3>
                Total:
                <span id="basketTotal">0 ₺</span>
            </h3>
        </div>

    </div>

</div>

@section Scripts
{
    <script>
        function getBasket() {
            return JSON.parse(localStorage.getItem("basket")) || [];
        }

        function saveBasket(basket) {
            localStorage.setItem("basket", JSON.stringify(basket));
        }

        function increaseQuantity(productId) {
            const basket = getBasket();
            const product = basket.find(x => x.productId === productId);

            if (product) {
                product.quantity += 1;
                saveBasket(basket);
                displayBasket();
            }
        }

        function decreaseQuantity(productId) {
            let basket = getBasket();
            const product = basket.find(x => x.productId === productId);

            if (product && product.quantity > 1) {
                product.quantity -= 1;
            } else {
                basket = basket.filter(x => x.productId !== productId);
            }

            saveBasket(basket);
            displayBasket();
        }

        function removeFromBasket(productId) {
            let basket = getBasket();

            basket = basket.filter(x => x.productId !== productId);

            saveBasket(basket);
            displayBasket();
        }

        function displayBasket() {
            const basket = getBasket();
            const basketBody = document.getElementById("basketBody");
            const basketTotal = document.getElementById("basketTotal");
            const basketContent = document.getElementById("basketContent");
            const emptyBasketMessage =
                document.getElementById("emptyBasketMessage");

            let html = "";
            let total = 0;

            if (basket.length === 0) {
                basketContent.style.display = "none";
                emptyBasketMessage.style.display = "block";
                basketBody.innerHTML = "";
                basketTotal.innerHTML = "0 ₺";
                return;
            }

            basketContent.style.display = "block";
            emptyBasketMessage.style.display = "none";

            basket.forEach(item => {
                const lineTotal = item.price * item.quantity;
                total += lineTotal;

                html += `
                            <tr>
                                <td>
                                    <img src="${item.imageUrl}"
                                         alt="${item.productName}"
                                         width="80"
                                         style="max-height: 80px; object-fit: contain;">
                                </td>

                                <td>${item.productName}</td>

                                <td>${item.price.toLocaleString("tr-TR")} ₺</td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-outline-secondary"
                                            onclick="decreaseQuantity(${item.productId})">
                                        -
                                    </button>

                                    <span class="mx-3">
                                        ${item.quantity}
                                    </span>

                                    <button type="button"
                                            class="btn btn-sm btn-outline-primary"
                                            onclick="increaseQuantity(${item.productId})">
                                        +
                                    </button>
                                </td>

                                <td>
                                    ${lineTotal.toLocaleString("tr-TR")} ₺
                                </td>

                                <td>
                                    <button type="button"
                                            class="btn btn-sm btn-danger"
                                            onclick="removeFromBasket(${item.productId})">
                                        Delete
                                    </button>
                                </td>
                            </tr>
                        `;
            });

            basketBody.innerHTML = html;
            basketTotal.innerHTML =
                total.toLocaleString("tr-TR") + " ₺";
        }

        displayBasket();
    </script>
}