<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>@ViewData["Title"] - MonitorShop Admin</title>

    <!-- Font Awesome -->
    <link rel="stylesheet"
          href="~/adminlte/plugins/fontawesome-free/css/all.min.css" />

    <!-- AdminLTE -->
    <link rel="stylesheet"
          href="~/adminlte/dist/css/adminlte.min.css" />
</head>

<body class="hold-transition sidebar-mini">

    <div class="wrapper">

        <!-- Navbar -->
        <nav class="main-header navbar navbar-expand navbar-white navbar-light">

            <ul class="navbar-nav">

                <li class="nav-item">
                    <a class="nav-link"
                       data-widget="pushmenu"
                       href="#"
                       role="button">

                        <i class="fas fa-bars"></i>

                    </a>
                </li>

                <li class="nav-item d-none d-sm-inline-block">

                    <a asp-controller="Home"
                       asp-action="Index"
                       class="nav-link">

                        Go to Store

                    </a>

                </li>

            </ul>

        </nav>


        <!-- Sidebar -->
        <aside class="main-sidebar sidebar-dark-primary elevation-4">

            <!-- Logo -->
            <a asp-controller="Product"
               asp-action="Index"
               class="brand-link">

                <span class="brand-text font-weight-light ml-2">
                    MonitorShop Admin
                </span>

            </a>


            <div class="sidebar">

                <nav class="mt-2">

                    <ul class="nav nav-pills nav-sidebar flex-column"
                        data-widget="treeview"
                        role="menu">

                        <!-- Products -->
                        <li class="nav-item">

                            <a asp-controller="Product"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-desktop"></i>

                                <p>Products</p>

                            </a>

                        </li>


                        <!-- Categories -->
                        <li class="nav-item">

                            <a asp-controller="Category"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-list"></i>

                                <p>Categories</p>

                            </a>

                        </li>


                        <!-- Users -->
                        <li class="nav-item">

                            <a asp-controller="User"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-users"></i>

                                <p>Users</p>

                            </a>

                        </li>


                        <!-- Roles -->
                        <li class="nav-item">

                            <a asp-controller="Role"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-user-tag"></i>

                                <p>Roles</p>

                            </a>

                        </li>


                        <!-- Baskets -->
                        <li class="nav-item">

                            <a asp-controller="BasketAdmin"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-shopping-cart"></i>

                                <p>Baskets</p>

                            </a>

                        </li>


                        <!-- Orders -->
                        <li class="nav-item">

                            <a asp-controller="Order"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-shopping-bag"></i>

                                <p>Orders</p>

                            </a>

                        </li>


                        <!-- Order Details -->
                        <li class="nav-item">

                            <a asp-controller="OrderDetail"
                               asp-action="Index"
                               class="nav-link">

                                <i class="nav-icon fas fa-file-invoice"></i>

                                <p>Order Details</p>

                            </a>

                        </li>

                    </ul>

                </nav>

            </div>

        </aside>


        <!-- Page Content -->
        <div class="content-wrapper">

            <section class="content-header">

                <div class="container-fluid">

                    <div class="row mb-2">

                        <div class="col-sm-6">

                            <h1>@ViewData["Title"]</h1>

                        </div>

                    </div>

                </div>

            </section>


            <section class="content">

                <div class="container-fluid">

                    @RenderBody()

                </div>

            </section>

        </div>


        <!-- Footer -->
        <footer class="main-footer">

            <strong>MonitorShop Admin Panel</strong>

            <div class="float-right d-none d-sm-inline-block">
                Graduation Project
            </div>

        </footer>

    </div>


    <!-- jQuery -->
    <script src="~/adminlte/plugins/jquery/jquery.min.js"></script>

    <!-- Bootstrap -->
    <script src="~/adminlte/plugins/bootstrap/js/bootstrap.bundle.min.js"></script>

    <!-- AdminLTE -->
    <script src="~/adminlte/dist/js/adminlte.min.js"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>