@model MonitorShop.Entities.Basket

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    ViewData["Title"] = "Delete Basket";
}

<h2>Delete Basket</h2>

<h4>Are you sure you want to delete this basket record?</h4>

<hr />

<dl class="row">
    <dt class="col-sm-2">
        User ID
    </dt>

    <dd class="col-sm-10">
        @Model.UserId
    </dd>

    <dt class="col-sm-2">
        Product ID
    </dt>

    <dd class="col-sm-10">
        @Model.ProductId
    </dd>

    <dt class="col-sm-2">
        Quantity
    </dt>

    <dd class="col-sm-10">
        @Model.Quantity
    </dd>
</dl>

<form asp-action="DeleteConfirmed" method="post">

    <input type="hidden" asp-for="Id" />

    <button type="submit" class="btn btn-danger">
        Delete
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Cancel
    </a>

</form>