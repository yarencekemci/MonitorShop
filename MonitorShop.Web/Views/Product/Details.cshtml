@model MonitorShop.Entities.Product

@{
    ViewData["Title"] = "Product Details";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container mt-5 mb-5">

    <div class="row align-items-center">

        <div class="col-lg-6 mb-4">
            <div class="border rounded p-4 text-center">

                <img src="@Model.ImageUrl"
                     alt="@Model.Name"
                     style="max-width: 100%; max-height: 450px; object-fit: contain;" />

            </div>
        </div>

        <div class="col-lg-6">

            <h1 class="mb-3">
                @Model.Name
            </h1>

            <p class="text-muted mb-3">
                @(Model.Category != null
                    ? Model.Category.Name
                    : "Monitor")
            </p>

            <h2 class="mb-4" style="color: #0e8ce4;">
                @Model.Price.ToString("N2") ₺
            </h2>

            <p class="mb-3">
                <strong>Stock:</strong> @Model.Stock
            </p>

            <p class="mb-4">
                @Model.Description
            </p>

            <button type="button"
                    class="btn btn-primary btn-lg">
                Add To Cart
            </button>

            <a asp-controller="Home"
               asp-action="Index"
               class="btn btn-outline-secondary btn-lg ml-2">
                Back to Home
            </a>

        </div>

    </div>

</div>