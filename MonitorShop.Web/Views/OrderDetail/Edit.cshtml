@model MonitorShop.Entities.OrderDetail

@{
    ViewData["Title"] = "Edit Order Detail";
}

<div class="container mt-4">
    <h2>Edit Order Detail</h2>

    <form asp-action="Edit" method="post">

        <input asp-for="Id" type="hidden" />

        <div asp-validation-summary="All" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="OrderId" class="form-label"></label>

            <select asp-for="OrderId"
                    asp-items="ViewBag.Orders"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="ProductId" class="form-label"></label>

            <select asp-for="ProductId"
                    asp-items="ViewBag.Products"
                    class="form-select">
            </select>
        </div>

        <div class="mb-3">
            <label asp-for="Quantity" class="form-label"></label>

            <input asp-for="Quantity" class="form-control" />
        </div>

        <div class="mb-3">
            <label asp-for="UnitPrice" class="form-label"></label>

            <input asp-for="UnitPrice"
                   class="form-control"
                   type="number"
                   step="0.01" />
        </div>

        <button type="submit" class="btn btn-warning">
            Update
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Back
        </a>

    </form>
</div>